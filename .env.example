# Firebase web config (Project settings → Your apps → Web app). Copy to .env.local.
# Without these values Okto runs in local-only mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public client ID from the Google OAuth configuration for the Windows desktop app.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
